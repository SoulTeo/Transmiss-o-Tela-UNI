PORT=10000
NODE_ENV=development
# Comma-separated exact origins. Set this to https://YOUR_GITHUB_USERNAME.github.io in Render.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional Coturn TURN REST API settings. Keep TURN_SECRET only on the backend.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
