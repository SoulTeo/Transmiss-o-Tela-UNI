{
  "name": "screen-share-room",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0 <27"
  },
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:server": "npm run dev -w backend",
    "dev:audio-bridge": "dotnet run --project native/WindowAudioBridge/WindowAudioBridge.csproj",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "smoke:server": "npm run smoke -w backend",
    "start": "npm run start -w backend"
  }
}
